# Reson8 speech-to-text (https://console.reson8.dev). Copy to .env.local and fill in; never commit the key.
RESON8_API_KEY=
# Optional: POST accepted proposals here instead of logging them.
VITE_AGENT_URL=
# Claude Haiku 5.5: the listener that turns the conversation into proposals. Server-side only.
ANTHROPIC_API_KEY=
# Backends (defaults shown): MCP server and repo-graph-api.
SPELUNK_MCP_URL=http://127.0.0.1:8788
SPELUNK_GRAPH_URL=http://127.0.0.1:18790
SPELUNK_REPO=rust-agent-framework
